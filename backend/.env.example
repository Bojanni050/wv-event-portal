# Copy to backend/.env and fill in real values. Never commit .env.

# PostgreSQL (asyncpg driver). Matches the docker-compose.yml service.
DATABASE_URL=postgresql+asyncpg://wv:wv@localhost:5432/wv_portal

# Auth
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Frontend base URL used to build password-reset / welcome links.
FRONTEND_URL=http://localhost:3000

# Seed accounts
ADMIN_EMAIL=admin@white-vision.nl
ADMIN_PASSWORD=change-me
DEMO_PASSWORD=change-me

# WordPress → portal sync
WP_API_KEY=change-me

# Emergent managed email proxy
EMERGENT_EMAIL_KEY=change-me
EMAIL_FROM_NAME=White Vision
