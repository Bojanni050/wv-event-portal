# Copy to backend/.env and fill in real values. Never commit .env.

# PostgreSQL (asyncpg driver).
# Local Docker:      postgresql+asyncpg://wv:wv@localhost:5432/wv_portal
# Hosted/managed:    add TLS, e.g. postgresql+asyncpg://user:pass@host:5432/db?ssl=require
DATABASE_URL=postgresql+asyncpg://wv:wv@localhost:5432/wv_portal

# Auth — JWT_SECRET must be at least 32 random bytes.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes

# Exact origins allowed to call the API with credentials, comma separated.
CORS_ORIGINS=https://app.white-vision.nl

# Public frontend base URL used to build password-reset / welcome links.
# MUST be https, otherwise the email link guard rejects every message.
FRONTEND_URL=https://app.white-vision.nl

# Bootstrap admin, created on first start. The password is never overwritten
# afterwards, so changing it in the app sticks across restarts.
ADMIN_EMAIL=admin@white-vision.nl
ADMIN_PASSWORD=replace-with-a-strong-password

# Demo customers/events/chat. Leave false in production.
SEED_DEMO=false
# Only read when SEED_DEMO=true.
DEMO_PASSWORD=replace-with-a-demo-password

# WordPress -> portal sync
WP_API_KEY=replace-with-a-strong-api-key

# Emergent managed email proxy
EMERGENT_EMAIL_KEY=replace-with-your-key
EMAIL_FROM_NAME=White Vision
